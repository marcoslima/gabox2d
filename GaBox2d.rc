/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About GaBox2d...",           ID_APP_ABOUT
    END
END

IDR_GaBox2dTYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Ambiente",                   ID_EDIT_EDITARCH
    END
    POPUP "&Simulação"
    BEGIN
        MENUITEM "&Play",                       ID_SIMULA_PLAY
        MENUITEM "&Reset",                      ID_SIMULA_RESET
        POPUP "&Velocidade"
        BEGIN
            MENUITEM "&Mais",                       ID_VELOCIDADE_MAIS
            MENUITEM "M&enos",                      ID_VELOCIDADE_MENOS
            MENUITEM SEPARATOR
            MENUITEM "1X",                          ID_VELOCIDADE_1X
            MENUITEM "2X",                          ID_VELOCIDADE_2X
            MENUITEM "4X",                          ID_VELOCIDADE_4X
            MENUITEM "10X",                         ID_VELOCIDADE_10X
            MENUITEM "100X",                        ID_VELOCIDADE_100X
        END
        MENUITEM "R&epetir",                    ID_SIMULA_REPETIR
    END
    POPUP "&Ga"
    BEGIN
        MENUITEM "&Iniciar GA...",              ID_GA_INICIARGA
        POPUP "&Mostrar atual:"
        BEGIN
            MENUITEM "&Melhor",                     ID_MOSTRAR_MELHOR
            MENUITEM "&Qualquer",                   ID_MOSTRAR_QUALQUER
        END
        MENUITEM SEPARATOR
        MENUITEM "&Extinsão em massa",          ID_GA_EXTINS
        MENUITEM "&Colar",                      ID_GA_COLAR
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        POPUP "Informações"
        BEGIN
            MENUITEM "&CPU",                        ID_VIEW_CPUINFO
            MENUITEM "&Ga Genes",                   ID_INFORMA_GAGENES
            MENUITEM "&Individuo atual",            ID_INFORMA_INDIVIDUOATUAL

        END
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About GaBox2d...",           ID_APP_ABOUT
    END
END


